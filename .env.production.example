# Copy to .env.production and replace the required values.
APP_HOSTNAME=applymate.example.com
APP_PORT=8080

# Use letters and numbers only because the value is used in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-value
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

JOB_CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30

# Optional SMTP settings for attention emails. Leave empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true
