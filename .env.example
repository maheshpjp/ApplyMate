# Core
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret
DATABASE_URL=postgresql+psycopg://applymate:applymate@postgres:5432/applymate
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173

# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Automation
BROWSER_HEADLESS=true
JOB_CHECK_INTERVAL_SECONDS=300
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
MAX_PARALLEL_JOBS=2

# Email alerts for schedules that need manual attention
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true

# Application
ACCESS_TOKEN_EXPIRE_MINUTES=1440
